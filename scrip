local HEAL_THRESHOLD = 0.8
local HEAL_COOLDOWN = 0.8
local lastHeal = 0

task.spawn(function()
    while task.wait(0.1) do
        if _G.AutoBandageEnabled then
            pcall(function()
                local char = player.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")

                if hum
                    and hum.Health > 0
                    and hum.Health < hum.MaxHealth * HEAL_THRESHOLD
                    and (os.clock() - lastHeal) >= HEAL_COOLDOWN then

                    lastHeal = os.clock()
                    ReplicatedStorage.Remotes.Heal:FireServer()
                end
            end)
        end
    end
end)

