local RunService = game:GetService("RunService")

local angle = 0
local FIXED_BOSS_POS = Vector3.new(-2790, 239, -1762)

local cachedBoss = nil
local lastBossSearch = 0
local BOSS_SEARCH_INTERVAL = 0.5

local function findBoss()
    local now = os.clock()

    -- Dùng boss đã cache nếu vẫn còn sống
    if cachedBoss
        and cachedBoss.Parent
        and cachedBoss.Name == "NPC2" then

        local hum = cachedBoss:FindFirstChildOfClass("Humanoid")
        local root = cachedBoss:FindFirstChild("HumanoidRootPart")

        if hum and root and hum.Health > 0 then
            return cachedBoss
        end
    end

    -- Không tìm lại liên tục
    if now - lastBossSearch < BOSS_SEARCH_INTERVAL then
        return nil
    end

    lastBossSearch = now
    cachedBoss = nil

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "NPC2" then
            local hum = obj:FindFirstChildOfClass("Humanoid")
            local root = obj:FindFirstChild("HumanoidRootPart")

            if hum and root and hum.Health > 0 then
                cachedBoss = obj
                return obj
            end
        end
    end

    return nil
end

RunService.Heartbeat:Connect(function()
    if _G.SelectedBossMode ~= "Chế Độ 2"
        or not _G.AutoFarmBossCircle then
        return
    end

    local character = player.Character
    if not character then
        return
    end

    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then
        return
    end

    local boss = findBoss()
    if not boss then
        return
    end

    local bossHum = boss:FindFirstChildOfClass("Humanoid")
    local bossRoot = boss:FindFirstChild("HumanoidRootPart")

    if not bossHum or not bossRoot or bossHum.Health <= 0 then
        cachedBoss = nil
        return
    end

    pcall(function()
        -- Khóa boss
        bossHum.WalkSpeed = 0
        bossRoot.CFrame = CFrame.new(FIXED_BOSS_POS)

        -- Settings
        local mode2 = _G.BossSettings
            and _G.BossSettings.Mode2

        local radius = (mode2 and mode2.Radius) or 19
        local rotSpeed = (mode2 and mode2.Speed) or 0.001

        -- Xoay
        angle = angle + rotSpeed

        if angle >= math.pi * 2 then
            angle = angle - math.pi * 2
        end

        local sinAngle = math.sin(angle)
        local cosAngle = math.cos(angle)

        local targetPos = FIXED_BOSS_POS + Vector3.new(
            cosAngle * radius,
            0,
            sinAngle * radius
        )

        -- Di chuyển + nhìn boss
        hrp.CFrame = CFrame.lookAt(
            targetPos,
            FIXED_BOSS_POS
        )

        -- Auto attack
        local tool = character:FindFirstChildOfClass("Tool")

        if tool then
            tool:Activate()
        else
            VirtualUser:CaptureController()
            VirtualUser:Button1Down(Vector2.new(0, 0))
            VirtualUser:Button1Up(Vector2.new(0, 0))
        end
    end)
end)
